# Postgres connection string. Neon and local Postgres both work.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/demohub

# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public URL of this app, including the scheme and port.
BETTER_AUTH_URL=http://localhost:3000

# The only person who can open the access-request page and approve people.
ADMIN_EMAIL=you@example.com

# Optional. Leave blank to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the sample webhook in demo 1. If unset, the app uses a built-in demo value.
# That fallback is for local review only. Set a real value before a public demo.
WEBHOOK_SIGNING_SECRET=
